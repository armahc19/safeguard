ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://safeguard:safeguard@localhost:5432/safeguard
REDIS_URL=redis://localhost:6379/0

# Required (32+ random chars) when ENVIRONMENT is staging/production:  openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-dev-only-secret

# JSON list / JSON object
CORS_ORIGINS=[]
TRUSTED_HOSTS=["localhost", "127.0.0.1"]
SECURITY_HEADERS=true
MAX_REQUEST_BODY_BYTES=1000000
GATEWAY_SECRETS={"ussd": "change-me", "sms": "change-me"}


# Outbound SMS. Keep console for local development only.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Optional internal Gradio, voice-agent and server-side speech recognition.
# Speech recognition and generated replies fall back to text/rule-based guidance when unset.
GROQ_API_KEY=

DEFAULT_CALLING_CODE=233

# Behavioural Intelligence lookback and velocity settings.
BEHAVIOUR_LOOKBACK_DAYS=30
BEHAVIOUR_VELOCITY_WINDOW_HOURS=24
BEHAVIOUR_VELOCITY_ALERT_COUNT=5
